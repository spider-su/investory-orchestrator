GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app-key
GITHUB_REPOSITORY=spider-su/investory
HOST_WORKSPACES_DIR=./workspaces
HOST_CODEX_DIR=./.codex
WORKSPACES_DIR=/app/workspaces
CHECKPOINT_DB=/app/data/checkpoints.db
TASK_DB=/app/data/tasks.db
# The Mac pull runner uses the same PostgreSQL database as the scheduler.
# Supply a real URL only in the protected runner environment file, never in job metadata.
DATABASE_URL=
RUNNER_TRANSPORT=ssh
# Optional integration-test connection. Use only the Investory .60 dev database;
# keep credentials in your local shell/profile and never commit this value.
TEST_POSTGRES_URL=
TEST_POSTGRES_SCHEMA=
BASE_BRANCH=main
MAX_ATTEMPTS=3
MAX_REPAIRS=3
WORKFLOW_MODE=simplified
MAX_FINAL_ATTEMPTS=3
MAX_FINAL_REVIEW_ATTEMPTS=3
MAC_REVIEW_TIMEOUT_SECONDS=1800
MAX_ACTIVE_TASKS=3
MAX_CODEX_PROCESSES=2
MAX_BUILDS=1
CI_RETRY_ATTEMPTS=3
QUEUE_POLL_SECONDS=30
RUNNER_HEALTH_CHECK_SECONDS=60
RUNNER_ID_PATH=~/.config/investory-orchestrator/runner-id
RUNNER_CAPABILITIES=codex,git,build,review
RUNNER_MAX_CODEX_PROCESSES=1
RUNNER_MAX_BUILDS=1
RUNNER_JOB_LEASE_SECONDS=90
RUNNER_HEARTBEAT_SECONDS=20
RUNNER_POLL_SECONDS=5
RUNNER_WORKSPACES_DIR=~/.investory-orchestrator/task-workspaces
RUNNER_RUNS_DIR=~/.investory-orchestrator/runs
RUNNER_LOG_DIR=~/.investory-orchestrator/runs/logs
RUNNER_RESULT_DIR=~/.investory-orchestrator/results
WORKER_HEARTBEAT_SECONDS=20
READY_ISSUE_LABEL=ready_to_develop
TARGET_ADAPTER=devcontainer_script
AGENT_DEVCONTAINER_SCRIPT=scripts/agent-devcontainer.sh
PLANNER_MODEL=
CODER_MODEL=
PUBLISH_PLAN_COMMENT=true
REVIEWER_MODEL=
PUBLISH_REVIEW_COMMENT=true
